server {
    listen 8080;
    server_name _;
    location / {
        proxy_pass http://${NODE_NAME}:${GATEWAY_NODEPORT};
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
